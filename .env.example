VITE_API_URL=https://agri-akap-backend-production.up.railway.app/api

# Paste your Google Maps JavaScript API key here (used by the Admin GIS maps).
# Get one at https://console.cloud.google.com/google/maps-apis/credentials
# with the "Maps JavaScript API" enabled for the project.
VITE_GOOGLE_MAPS_API_KEY=

# Cloudflare Turnstile (public site key — secret stays on the backend)
VITE_TURNSTILE_SITE_KEY=
